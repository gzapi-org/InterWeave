<!-- SPIKE-009 device harness: EVIDENCE ONLY, never a production app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.interweave.spike009">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:label="SPIKE-009"
        android:allowBackup="false"
        android:extractNativeLibs="true">

        <!-- Driven from the shell only: DUMP is held by the shell and the system. -->
        <receiver
            android:name=".Cmd"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- D6b: one fingerprint per operation, started from the shell. -->
        <activity
            android:name=".Prompt"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- D7: the phrase screen under test, and its unprotected control. -->
        <activity
            android:name=".Phrase"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:windowSoftInputMode="stateVisible" />
    </application>
</manifest>
