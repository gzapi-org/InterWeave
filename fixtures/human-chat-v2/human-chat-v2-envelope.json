{
  "algorithm": {
    "id": "human-chat-v2-envelope",
    "specification": "architecture/clients/human/HUMAN-CHAT.md",
    "summary": "Envelope shape and grammar per ADR-0050. Verdict set. The markdown SUBSET is deliberately NOT decided here: out-of-subset markdown falls back to plain-text display rather than rejecting the envelope, so subset conformance is a rendering contract and belongs in tests/human-chat, not in a validity verdict."
  },
  "adr": [
    "0044",
    "0050"
  ],
  "vectors": [
    {
      "name": "minimal-valid",
      "envelope": {
        "v": 2,
        "kind": "text",
        "app_message_id": "00000000000000000000000000000000",
        "text": "hello"
      },
      "valid": true
    },
    {
      "name": "all-zero-id",
      "envelope": {
        "v": 2,
        "kind": "text",
        "app_message_id": "00000000000000000000000000000000",
        "text": "hello"
      },
      "valid": true
    },
    {
      "name": "markdown-body",
      "envelope": {
        "v": 2,
        "kind": "text",
        "app_message_id": "00000000000000000000000000000000",
        "text": "## Status\n\n- one\n- two\n"
      },
      "valid": true
    },
    {
      "name": "reply-to-unknown-message",
      "envelope": {
        "v": 2,
        "kind": "text",
        "app_message_id": "00000000000000000000000000000000",
        "text": "hello",
        "reply_to": "11111111111111111111111111111111"
      },
      "valid": true,
      "note": "An unresolvable reply_to stays valid and triggers no network lookup."
    },
    {
      "name": "timestamp-zero",
      "envelope": {
        "v": 2,
        "kind": "text",
        "app_message_id": "00000000000000000000000000000000",
        "text": "hello",
        "sent_at_ms": 0
      },
      "valid": true
    },
    {
      "name": "timestamp-max",
      "envelope": {
        "v": 2,
        "kind": "text",
