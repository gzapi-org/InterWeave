        "sent_at_ms": 253402300799999
      },
      "valid": true
    },
    {
      "name": "from-endpoint-hint",
      "envelope": {
        "v": 2,
        "kind": "text",
        "app_message_id": "00000000000000000000000000000000",
        "text": "hello",
        "from_endpoint": "human"
      },
      "valid": true
    },
    {
      "name": "unknown-field-ignored",
      "envelope": {
        "v": 2,
        "kind": "text",
        "app_message_id": "00000000000000000000000000000000",
        "text": "hello",
        "future_extension": {
          "anything": 1
        }
      },
      "valid": true,
      "note": "The v2 schema is OPEN by design; an unknown field is ignored, not rejected."
    },
