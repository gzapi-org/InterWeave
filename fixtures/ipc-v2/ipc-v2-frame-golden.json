{
  "algorithm": {
    "id": "ipc-v2-length-prefix-v1",
    "specification": "architecture/contracts/LOCAL-IPC.md",
    "summary": "One IPC v2 frame per vector: a 4-byte unsigned big-endian length N, then N bytes of the body as UTF-8 JSON (LOCAL-IPC.md §Framing). N is at most 131,072 and never zero; the prefix is outside N.",
    "canonical_form": "The body as serde_json's compact writer emits it: no whitespace, keys in the order the vector lists them (preserve_order), non-ASCII written as UTF-8 rather than escaped, integers only. LOCAL-IPC.md pins no canonical JSON form — a reader accepts any object — so this is the form the goldens freeze, not a rule of the wire.",
    "scope": "Every body validates against ipc/frame 2.0.0 (and a request's (method, params) pair against ipc/request, an event's (event_type, data) pair against ipc/event) at the version these vectors were frozen. Phase and direction rules — hello first, hello_response and close server-only — are asserted by tests/ipc-v2, not here."
  },
  "adr": [
    "0017",
    "0037"
  ],
  "vectors": [
