//
// The reference views (plan §17 (8)), as agreed with rust-ui-dev (relay
// seqs 10823, 10826, 10849, 10867, 10870, 10879, 10882, 10885): every
// string arrives from Rust, already chosen from ui-model's placeholder
// table, and every person action leaves as a raw input the Rust side
// resolves against the model. Nothing here decides what is legal.
//
// The `focus-id` writes are test plumbing: Slint's element search has
// no focus query, so each focusable element reports itself when it gains
// focus. They are never shown and never person-facing.

export struct ActionRow {
    // Position in the item's rendered actions: identifies the press,
    // which the Rust side turns back into the action as rendered.
    index: int,
    text: string,
}

export struct ConversationRow {
    handle: int,
    title: string,
    // Says direct or channel as text, never colour alone (U2a).
    // Direct or channel and the unread count, from one template.
    description: string,
    selected: bool,
}

// What a body line is: how it is drawn (`body.rs`).
export enum LineKind { text, heading, code, rule, table-header, table-row }

// One line of a body, as plain text: never markup (architect-cto's B6
// ruling -- no second parser reads remote-derived text).
export struct BodyLine {
    kind: LineKind,
    // A heading's level, 1 to 6; 0 otherwise.
    level: int,
    // How many lists and quotes it sits in.
    depth: int,
    quoted: bool,
    // A list item's marker on its first line: a bullet, or "3.".
    marker: string,
    text: string,
}

// One link of a body: a separate control, activated only by a person,
// labelled with its full destination (HUMAN-CHAT.md, human-client-ui.md
// section 13). The index identifies the press, as an action's does.
export struct LinkRow {
    index: int,
    label: string,
}

export struct MessageRow {
    handle: int,
    // Short author, then status, then body (U5a).
    label: string,
    author: string,
    // The full PeerId of an inbound author, exact (§11, U5a); empty for
    // this client's own.
    author-id: string,
    route: string,
    status: string,
    // The source as received, shown on the person's request: always
    // viewable, however it rendered (HUMAN-CHAT.md).
    source: string,
    // The body drawn from the block tree, and its links.
    lines: [BodyLine],
    links: [LinkRow],
    reply: string,
    actions: [ActionRow],
}

component ActionButton inherits FocusScope {
    in property <string> text;
    in property <string> focus-key;
    callback pressed();
    callback focused(string);
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.pressed(); }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.pressed();
            return accept;
        }
        reject
    }
    changed has-focus => {
        if (self.has-focus) { root.focused(root.focus-key); }
    }
    min-height: 24px;
    Rectangle {
        border-width: root.has-focus ? 2px : 1px;
        border-color: #444;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            // The caption is the button's label already: not a second node.
            Text { text: root.text; vertical-alignment: center; accessible-role: none; }
        }
    }
    TouchArea { clicked => { root.pressed(); } }
}

// A link's control: its label is the full destination, which may be
// long and have no spaces, so it wraps -- inside a word if it must --
// rather than widening the window, and reads from the left.
component LinkButton inherits FocusScope {
    in property <string> text;
    in property <string> focus-key;
    callback pressed();
    callback focused(string);
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.pressed(); }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.pressed();
            return accept;
        }
        reject
    }
    changed has-focus => {
        if (self.has-focus) { root.focused(root.focus-key); }
    }
    // The layout is the control's ONLY child, the touch area inside it:
    // with a sibling beside the layout the control kept one line's height
    // whatever the destination wrapped to, and the lines below overlapped
    // the next control (seen in the rendered window).
    VerticalLayout {
        Rectangle {
            border-width: root.has-focus ? 2px : 1px;
            border-color: #444;
            HorizontalLayout {
                padding: 4px;
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: root.text;
                    wrap: word-wrap;
                    // A word longer than the line breaks inside itself
                    // rather than widening the list (seen with a long URL).
                    min-width: 0;
                    horizontal-alignment: left;
                    accessible-role: none;
                }
            }
            TouchArea { clicked => { root.pressed(); } }
        }
    }
}

// Colours, each pair holding at least WCAG AA contrast (4.5:1) for text.
global Palette {
    out property <color> pane: #f3f3f3;
    out property <color> divider: #c8c8c8;
    out property <color> muted-text: #4a4a4a;
    out property <color> notice-background: #fff4ce;
    out property <color> notice-text: #3d2c00;
    out property <color> refused-text: #8a1c1c;
    out property <color> selected: #dde8f7;
}

export component AppWindow inherits Window {
    in property <string> window-title;
    title: root.window-title;
    preferred-width: 900px;
    preferred-height: 640px;

    in property <string> conversations-heading;
    in property <string> messages-heading;
    in property <[ConversationRow]> conversations;
    in property <[MessageRow]> messages;
    in property <string> header-title;
    // The full PeerId of a direct conversation, or the channel id (U5a).
    in property <string> header-id;
    in property <string> header-id-label;
    in property <string> connectivity;
    in property <bool> has-notice;
    in property <string> notice;
    in property <bool> has-notice-action;
    in property <string> notice-action;
    in property <bool> composer-enabled;
    in property <string> composer-label;
    in-out property <string> draft;
    in property <string> refused;
    in property <string> send-label;
    in property <string> show-source-label;
    in property <string> show-formatted-label;
    // The platform's monospaced family, by name: Slint reads a
    // `font-family` as a name, so the generic "monospace" matches nothing.
    in property <string> code-font;
    // The window's one announcement, in two slots that take turns, so
    // the same sentence twice is still a change (rust-ui-dev F4).
    in property <string> announcement-a;
    in property <string> announcement-b;
    out property <string> focus-id;

    callback select(int);
    callback action(int, int);
    callback link(int, int);
    callback send();
    callback notice-pressed();
    callback draft-edited(string);

    // The announcement, for a screen reader only: a sighted
    // person sees each change where it happened. Clipped to a
    // point rather than hidden, which would take it out of the
    // accessibility tree.
    Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        clip: true;
        announce-a := Text {
            text: root.announcement-a;
            accessible-role: text;
            accessible-label: self.text;
            accessible-live-region: polite;
        }
        announce-b := Text {
            text: root.announcement-b;
            accessible-role: text;
            accessible-label: self.text;
            accessible-live-region: polite;
        }
    }
    HorizontalLayout {
        Rectangle {
            width: 280px;
            background: Palette.pane;
        VerticalLayout {
            padding: 12px;
            spacing: 6px;
            Text {
                text: root.conversations-heading;
                font-weight: 700;
                font-size: 16px;
                accessible-role: text;
                accessible-label: self.text;
            }
            // Any number of conversations: the list scrolls rather than
            // raising the window's minimum height past the screen. A row
            // keyboard focus reaches is brought into view by the toolkit,
            // which reveals an item when it takes focus.
            Flickable {
                vertical-stretch: 1;
                viewport-height: conversations-column.preferred-height;
            conversations-column := VerticalLayout {
                width: parent.width;
                spacing: 6px;
                alignment: start;
            for row[index] in root.conversations: FocusScope {
                accessible-role: list-item;
                accessible-label: row.title;
                accessible-item-index: index;
                accessible-item-count: root.conversations.length;
                accessible-description: row.description;
                accessible-item-selectable: true;
                accessible-item-selected: row.selected;
                accessible-action-default => { root.select(row.handle); }
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == " ") {
                        root.select(row.handle);
                        return accept;
                    }
                    reject
                }
                changed has-focus => {
                    if (self.has-focus) { root.focus-id = "conversation:" + row.handle; }
                }
                min-height: 44px;
                Rectangle {
                    background: row.selected ? Palette.selected : transparent;
                    border-radius: 4px;
                }
                VerticalLayout {
                    padding: 6px;
                    // The row's label and description already say these.
                    Text { text: row.title; accessible-role: none; }
                    Text {
                        text: row.description;
                        color: Palette.muted-text;
                        font-size: 12px;
                        accessible-role: none;
                    }
                }
                TouchArea { clicked => { root.select(row.handle); } }
            }
            }
            }
        }
        }
        Rectangle { width: 1px; background: Palette.divider; }
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text {
                text: root.connectivity;
                color: Palette.muted-text;
                font-size: 12px;
                accessible-role: text;
                accessible-label: self.text;
                accessible-live-region: polite;
            }
            if root.has-notice: Rectangle {
                background: Palette.notice-background;
                border-radius: 4px;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: root.notice;
                    color: Palette.notice-text;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    accessible-role: text;
                    accessible-label: self.text;
                    accessible-live-region: polite;
                }
                if root.has-notice-action: ActionButton {
                    text: root.notice-action;
                    focus-key: "notice";
                    pressed => { root.notice-pressed(); }
                    focused(k) => { root.focus-id = k; }
                }
            }
            }
            Text {
                text: root.header-title;
                font-weight: 700;
                font-size: 16px;
                accessible-role: text;
                accessible-label: self.text;
                accessible-description: root.header-id;
            }
            // The identifier in exact canonical form, selectable so a person
            // can copy it with the platform's own keys (human-client-ui.md
            // section 11). Read-only: nothing typed here goes anywhere.
            if root.header-id != "": TextInput {
                text: root.header-id;
                read-only: true;
                single-line: true;
                font-size: 12px;
                color: Palette.muted-text;
                accessible-label: root.header-id-label;
                accessible-value: self.text;
            }
            Text {
                text: root.messages-heading;
                color: Palette.muted-text;
                font-size: 12px;
                accessible-role: text;
                accessible-label: self.text;
            }
            // A long conversation scrolls; the composer stays in view. The
            // built-in Flickable, not std-widgets' ScrollView, whose icons
            // need an image feature the graph does not carry: it scrolls
            // by wheel and touch, with no visible scrollbar.
            Flickable {
                vertical-stretch: 1;
                viewport-height: messages-column.preferred-height;
            messages-column := VerticalLayout {
                width: parent.width;
                spacing: 10px;
                alignment: start;
            for row[index] in root.messages: item := FocusScope {
                // The person's choice for this message, kept with its row
                // while the row exists: the drawn body, or the source.
                in-out property <bool> show-source: false;
                accessible-role: list-item;
                accessible-label: row.label;
                accessible-item-index: index;
                accessible-item-count: root.messages.length;
                changed has-focus => {
                    if (self.has-focus) { root.focus-id = "item:" + row.handle; }
                }
                VerticalLayout {
                    HorizontalLayout {
                        Text {
                            text: row.author;
                            accessible-role: text;
                            accessible-label: self.text;
                            accessible-description: row.author-id;
                        }
                        Text {
                            text: row.route;
                            accessible-role: text;
                            accessible-label: self.text;
                        }
                        // Not a live region: the window's one announcement
                        // says what changed (rust-ui-dev F4).
                        Text {
                            text: row.status;
                            accessible-role: text;
                            accessible-label: self.text;
                        }
                    }
                    if row.reply != "": Text {
                        text: row.reply;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                    if !item.show-source: VerticalLayout {
                        spacing: 4px;
                        for line in row.lines: HorizontalLayout {
                            padding-left: line.depth * 16px;
                            spacing: 6px;
                            if line.quoted: Rectangle {
                                width: 3px;
                                background: Palette.divider;
                            }
                            if line.marker != "": Text {
                                horizontal-stretch: 0;
                                text: line.marker;
                                // Said with the line's own label.
                                accessible-role: none;
                            }
                            if line.kind == LineKind.rule: Rectangle {
                                height: 1px;
                                background: Palette.divider;
                            }
                            if line.kind != LineKind.rule: Rectangle {
                                horizontal-stretch: 1;
                                background: line.kind == LineKind.code ? Palette.pane : transparent;
                                HorizontalLayout {
                                    padding: line.kind == LineKind.code ? 6px : 0px;
                                    Text {
                                        text: line.text;
                                        wrap: word-wrap;
                                        // A word longer than the line breaks inside itself rather
                                        // than widening the list (seen with a long URL in the body).
                                        min-width: 0;
                                        font-family: line.kind == LineKind.code ? root.code-font : "";
                                        font-weight: line.kind == LineKind.heading || line.kind == LineKind.table-header ? 700 : 400;
                                        font-size: line.kind == LineKind.heading ? max(14px, 24px - line.level * 2px) : 14px;
                                        accessible-role: text;
                                        accessible-label: line.marker != "" ? line.marker + " " + self.text : self.text;
                                    }
                                }
                            }
                        }
                    }
                    if item.show-source: Text {
                        text: row.source;
                        wrap: word-wrap;
                        // A word longer than the line breaks inside itself rather
                        // than widening the list (seen with a long URL in the body).
                        min-width: 0;
                        font-family: root.code-font;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                    // One control per link, after the text it came from, its full
                    // destination as its label; nothing opens but a person's
                    // activation. Part of the drawn body: the source shown in
                    // its place has none, as a body past a bound has none.
                    if !item.show-source: VerticalLayout {
                        for link in row.links: LinkButton {
                            text: link.label;
                            focus-key: "link:" + row.handle + ":" + link.index;
                            pressed => { root.link(row.handle, link.index); }
                            focused(k) => { root.focus-id = k; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for action in row.actions: ActionButton {
                            text: action.text;
                            focus-key: "action:" + row.handle + ":" + action.index;
                            pressed => { root.action(row.handle, action.index); }
                            focused(k) => { root.focus-id = k; }
                        }
                        ActionButton {
                            text: item.show-source ? root.show-formatted-label : root.show-source-label;
                            focus-key: "source:" + row.handle;
                            pressed => { item.show-source = !item.show-source; }
                            focused(k) => { root.focus-id = k; }
                        }
                    }
                }
            }
            }
            }
            // A refused send is announced: the primary action's failure is
            // otherwise silent to a screen reader (rust-ui-dev F3).
            Text {
                text: root.refused;
                color: Palette.refused-text;
                accessible-role: text;
                accessible-label: self.text;
                accessible-live-region: polite;
            }
            // The composer exists only for an open conversation: an empty,
            // disabled box would offer nothing to type into.
            if root.composer-enabled: HorizontalLayout {
                spacing: 8px;
                height: 36px;
                Rectangle {
                    border-width: 1px;
                    border-color: #444;
                    border-radius: 4px;
                    input := TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        vertical-alignment: center;
                        text <=> root.draft;
                        enabled: root.composer-enabled;
                        accessible-label: root.composer-label;
                        edited => { root.draft-edited(self.text); }
                        changed has-focus => {
                            if (self.has-focus) { root.focus-id = "composer"; }
                        }
                    }
                }
                if root.composer-enabled: ActionButton {
                    text: root.send-label;
                    focus-key: "send";
                    pressed => { root.send(); }
                    focused(k) => { root.focus-id = k; }
                }
            }
        }
    }
}
